# ---- Database (TigerData Cloud — managed Postgres + TimescaleDB) ----
#
# THIS FILE IS COMMITTED TO GIT. Never put a real password here.
# Real values go in ion/.env.local, which is gitignored.
#
# Console → your service → Connection info. The password is shown ONCE at
# service creation; if you lose it, reset it rather than hunting for it.
#
# KEEP BOTH QUERY PARAMS. sslmode=require is mandatory (Tiger Cloud refuses
# plaintext), but pg >= 8.23 reinterprets bare `require` as `verify-full`,
# which fails with "self-signed certificate in certificate chain".
# uselibpqcompat=true restores libpq's meaning of `require`: encrypt the
# connection, don't verify the certificate.
DATABASE_URL="postgres://tsdbadmin:PASSWORD@SERVICE_ID.PROJECT.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require&uselibpqcompat=true"

# ---- Auth (Auth.js / next-auth magic link) ----
AUTH_SECRET=""            # openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# ---- Email (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="alerts@yourdomain.dev"   # use onboarding@resend.dev until a domain is verified

# ---- AI (Google Gemini) ----
GEMINI_API_KEY=""
# Free-tier quota is per model and small (20 requests on gemini-3.8-flash when
# we hit it). Only *changed* pages call Gemini, but during heavy testing you can
# exhaust it; gemini-3.5-flash and gemini-3.1-flash-lite have their own quota.
# Billing / hackathon credits lift the cap. `npm run ai:check` tells you fast.
GEMINI_MODEL="gemini-3.5-flash"

# ---- Worker / cron ----
CRON_SECRET=""            # random string; required in Authorization header on /api/cron/*
FETCH_TIMEOUT_MS="15000"
MAX_RESPONSE_BYTES="2000000"
USER_AGENT="iOnBot/1.0 (+https://yourapp.vercel.app/bot)"

# ---- Optional: headless browser fallback for JS-rendered pages ----
BROWSERLESS_API_KEY=""

# ---- Feature flags ----
ENABLE_AI_JUDGE="true"
