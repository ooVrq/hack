# ---- Database (TigerData Cloud — managed Postgres + TimescaleDB) ----
# Console → your service → Connection info. The password is shown ONCE at
# service creation; if you lose it, reset it rather than hunting for it.
#
# KEEP BOTH QUERY PARAMS. sslmode=require is mandatory (Tiger Cloud refuses
# plaintext), but pg >= 8.23 reinterprets bare `require` as `verify-full`,
# which fails against Tiger Cloud's chain with "self-signed certificate in
# certificate chain". uselibpqcompat=true restores the standard libpq meaning
# of `require`: encrypt the connection, don't verify the certificate.
# To verify properly instead, download Tiger Cloud's CA cert and use
# `sslmode=verify-full&sslrootcert=/path/to/ca.crt` with no uselibpqcompat.
DATABASE_URL="postgres://tsdbadmin:vlrlbfqxsgoojw6m@uixx0p8fhn.ba7igx2meh.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require&uselibpqcompat=true"

# ---- Auth (Auth.js / next-auth magic link) ----
AUTH_SECRET=""            # openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# ---- Email (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="alerts@yourdomain.dev"   # use onboarding@resend.dev until a domain is verified

# ---- AI (Google Gemini) ----
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ---- Worker / cron ----
CRON_SECRET=""            # random string; required in Authorization header on /api/cron/*
FETCH_TIMEOUT_MS="15000"
MAX_RESPONSE_BYTES="2000000"
USER_AGENT="WatchtowerBot/1.0 (+https://yourapp.vercel.app/bot)"

# ---- Optional: headless browser fallback for JS-rendered pages ----
BROWSERLESS_API_KEY=""

# ---- Feature flags ----
ENABLE_AI_JUDGE="true"
ENABLE_ROBOTS_CHECK="true"
